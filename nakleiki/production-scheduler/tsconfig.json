{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/components/BrigadeBoard.tsx",
    "src/components/CompleteShiftReportDialog.tsx",
    "src/components/ManagerPayoutsClient.tsx",
    "src/components/ReportReviewActions.tsx",
    "src/components/ReportTextEditor.tsx",
    "src/components/ShiftFormModal.tsx",
    "src/components/ZoneForm.tsx",
    "src/components/ZoneLimitForm.tsx"
  ]
}
