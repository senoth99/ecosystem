generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id              String   @id @default(cuid())
  fullName        String
  department      String
  salary          Int
  payoutDate      DateTime
  worksFromMonth  Int
  worksFromYear   Int
  hasNda          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
