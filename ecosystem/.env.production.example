# Скопируйте на сервер: cp .env.production.example .env
# Заполните все значения с ? или CHANGE_ME

# === Домен и HTTPS (Caddy + Let's Encrypt) ===
DOMAIN=eco.cashercollection.com
ACME_EMAIL=admin@cashercollection.com
PUBLIC_BASE_URL=https://eco.cashercollection.com

# === Секреты (сгенерируйте: openssl rand -hex 32) ===
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
POSTGRES_PASSWORD=CHANGE_ME_STRONG
# Пароль БД drops; на каждом деплое синхронизируется с Postgres (см. deploy/lib-postgres.sh)
DROPS_DB_PASSWORD=CHANGE_ME_STRONG

POSTGRES_USER=ecosystem
POSTGRES_DB=ecosystem

# === Cookie SSO (общий домен) ===
COOKIE_DOMAIN=.cashercollection.com
COOKIE_SECURE=true

# === Telegram — единый бот экосистемы ===
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUPERADMIN_USERNAMES=contact_voropaev,ivanvoropaeff
TELEGRAM_ALLOW_DEV_LOGIN=false

# Опционально: отдельные боты для scheduler (уведомления смен)
SCHEDULER_TELEGRAM_BOT_TOKEN=
SCHEDULER_TELEGRAM_BOT_USERNAME=

# === Casher API ===
CASHER_API_BASE=https://api.cashercollection.com
CASHER_PROMOCODES_TOKEN=

# === Прокси картинок ===
IMG_PROXY_HOSTS=api.cashercollection.com,cdn.cashercollection.com
