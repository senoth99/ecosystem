# === Общие ===
DOMAIN=localhost
SESSION_SECRET=change-me-to-32-chars-minimum-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false

# === Postgres (ecosystem + drops) ===
ECOSYSTEM_DATABASE_URL=postgresql://ecosystem:ecosystem@postgres:5432/ecosystem
DROPS_DATABASE_URL=postgresql://drops:drops@postgres:5432/drops

# === Telegram (единый бот экосистемы) ===
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUPERADMIN_USERNAMES=contact_voropaev,ivanvoropaeff
TELEGRAM_ALLOW_DEV_LOGIN=false

# === URLs (внутри docker network) ===
AUTH_SERVICE_URL=http://auth-service:4001
CATALOG_SERVICE_URL=http://catalog:4002
MEDIA_SERVICE_URL=http://media:4003
PUBLIC_BASE_URL=http://localhost

# === Casher API ===
CASHER_API_BASE=https://api.cashercollection.com
CASHER_PROMOCODES_TOKEN=

# === App paths (nginx) ===
APP_BLOGGERS_PATH=/bloggers
APP_DROPS_PATH=/drops
APP_SCHEDULER_PATH=/scheduler
APP_SHOP_PATH=/shop
APP_NAKLEIKI_PATH=/nakleiki
APP_PROIZVODSTVO_PATH=/proizvodstvo
APP_ZAKAZI_PATH=/zakazi
APP_ZARPLATY_PATH=/zarplaty
